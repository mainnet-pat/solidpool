# The repository root's settings: the apps and indexers that docker-compose.yml runs, which
# `docker compose` reads from a .env file here. web/.env.example says what each of the app's settings
# is for, under the same names. The deployment scripts take theirs on the command line
# (PRODUCTION.md), and the deployer's key is typed at their prompt, or read from a file only its
# owner can read, never from here.

# Each network's two pool factories: their categories, 64 hex digits each, which
# deployments/<network>.json names under `factories`. That network's indexer follows them, and
# reads its pair as BCH_FACTORY and TOKEN_FACTORY; every app reads all four by these names.
MAINNET_BCH_FACTORY=d8db78466ca0636f0f1ab902aa9efa8833ab18345011faf8dc3a9e2cb53c26c7
MAINNET_TOKEN_FACTORY=da5397afd56f2ff9c732699c0849133b0d4b4256a2fcd5848c60bac678185d21
CHIPNET_BCH_FACTORY=b6ebe8575e5c9f2dbc193486245cfbe1a02dd32a8648127eb11bc28b58047ecb
CHIPNET_TOKEN_FACTORY=cf0006fa6a53a4309293cb4bb548f9d2f5a5da0ec2bf69e5c02fa817dd443bc8
# A Fulcrum server of your own for each indexer, running Fulcrum 1.10 or later: wss://, or ws:// to
# one on this machine or its private network, such as a container beside it. The indexer reads it as
# FULCRUM_URL, and no app reads it: the apps' servers are below, wss:// only.
# The indexer lists the pools it shows and refuses one older or of another chain, so no public
# server is a default. It runs on Fulcrum's default limits, as public servers do: a lock padded
# past its max_history is reported as the server's limit, never as an empty pool (PRODUCTION.md).
MAINNET_INDEXER_FULCRUM_URL=wss://electrum.imaginary.cash:50004
CHIPNET_INDEXER_FULCRUM_URL=wss://chipnet.bch.ninja:50004

# The indexers publish no port: nginx joins their `solidpool` network and serves each at the
# public https:// URL its network's _INDEXER_URL names (below).

# Archive requests one client may make a minute; 0 leaves limits to nginx. The indexer counts the
# client nginx names last in X-Forwarded-For.
ARCHIVE_RATE_LIMIT=1200
# Pool lists one client may ask for a minute: the app's server keeps the list a few seconds.
POOLS_RATE_LIMIT=120

# Optional, for the indexers and the apps alike: the token metadata service, Paytaca's by default.
# BCMR_SERVICE_URL=https://bcmr.paytaca.com

# Optional, for the apps: another WalletConnect relay, and a CDN for the prover's files, which every
# page then fetches from there (web/.env.example). Unset, the apps use WalletConnect's relay and
# serve the files themselves.
# WALLETCONNECT_RELAY_URL=wss://relay.walletconnect.org
# NEXT_PUBLIC_CIRCUIT_URL=https://cdn.example/withdraw.json
# NEXT_PUBLIC_PROVING_KEY_URL=https://cdn.example/withdraw_proving_key.bin

# Each network's two Fulcrum servers for the apps, wss:// and of different operators, which every
# browser reads, and its indexer's public https:// URL, if it has one. Every app is given every
# network's settings, the factories above included, and offers each network they set up: set all
# four of a network's servers and factories, or none of its settings, or the apps stop and name
# what is missing. Each profile's app opens on its own network, which must be set up.
MAINNET_TRUSTLESS_FULCRUM_URL=wss://electrum.imaginary.cash:50004
MAINNET_TRUSTLESS_BROADCAST_URL=wss://electroncash.dk:50004
MAINNET_INDEXER_URL=https://mainnet.solidpool.cash
CHIPNET_TRUSTLESS_FULCRUM_URL=wss://chipnet.imaginary.cash:50004
CHIPNET_TRUSTLESS_BROADCAST_URL=wss://chipnet.bch.ninja:50004
CHIPNET_INDEXER_URL=https://chipnet.solidpool.cash

# Each app's public https:// origin. The WalletConnect project is shared, as is SOURCE_URL: the
# public https:// address of the exact source the images are built from, such as its commit or tag
# in a public repository, which every page links to (web/.env.example).
MAINNET_SITE_URL=https://solidpool.cash
CHIPNET_SITE_URL=https://solidpool.cash
WALLETCONNECT_PROJECT_ID=3fd234b8e2cd0e1da4bc08a0011bbf64
SOURCE_URL=https://github.com/mainnet-pat/solidpool
